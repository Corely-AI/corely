# Copy with pnpm focused:init; never put these keys in VITE_* or commit .env.focused.local.
CORELY_DEV_API_ORIGIN=http://127.0.0.1:3000
CORELY_DEV_TLS_KEY=local/focused/key.pem
CORELY_DEV_TLS_CERT=local/focused/cert.pem
CORELY_SSO_SECRET=REPLACE_SSO_ENCRYPTION_KEY
CORELY_SSO_PROXY_KEY=REPLACE_PRIVATE_PROXY_KEY
VITE_CORELY_API_BASE_PATH=/api/bff
VITE_CORELY_LOGIN_ORIGIN=https://login.corely.test:8443
VITE_CORELY_APP_CENTER_ORIGIN=https://app.corely.test:8443
VITE_CORELY_INVOICE_ORIGIN=https://invoice.app.corely.test:8443
VITE_CORELY_HR_ORIGIN=https://hr.app.corely.test:8443
