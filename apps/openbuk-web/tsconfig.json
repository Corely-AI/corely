{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@corely/auth-client": ["../../packages/auth-client/src/index.ts"],
      "@corely/api-client": ["../../packages/api-client/src/index.ts"]
    }
  },
  "include": ["src"]
}
