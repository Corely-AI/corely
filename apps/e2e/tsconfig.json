{
  "extends": "@corely/tsconfig/lib.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.api.config.ts",
    "playwright.sso.config.ts",
    "playwright.workspace-session.config.ts",
    "playwright.openbuk.config.ts",
    "playwright.cash.config.ts",
    "playwright.pos.config.ts",
    "tax/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts",
    "helpers/**/*.ts"
  ]
}
